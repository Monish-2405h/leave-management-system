# ============================
# Leave Management System
# Root .gitignore
# ============================

# ⚠️ SECRETS - NEVER UPLOAD THESE
.env
.env.local
.env.development.local
.env.production.local
.env.production

# Node Dependencies (too heavy, run npm install to regenerate)
node_modules/
**/node_modules/

# Build Outputs (optional: remove 'dist' if you want to deploy from dist)
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Generated
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.suo
*.sln
