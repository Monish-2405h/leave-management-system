PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=student_db

# JWT Secret (use a long random string in production)
JWT_SECRET=your_jwt_secret_key_here
